# Copie este arquivo para ".env" e ajuste os valores se necessário.
# Nenhuma variável é obrigatória — a aplicação já roda com os padrões abaixo.

# Endereço em que o servidor vai escutar.
HOST=127.0.0.1

# Porta em que o servidor vai escutar.
PORT=8000

# Reinicia o servidor automaticamente ao detectar mudanças no código
# (recomendado para desenvolvimento; use "false" em ambientes de teste/entrega).
RELOAD=true
